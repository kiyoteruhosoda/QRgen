# Dart / Flutter build output.
#
# None of this is reproducible-by-hand state: it is regenerated by
# `flutter pub get` and `flutter build`. Same shape as flutterbase's
# .gitignore (task #468); CI checks the tree stays clean after both.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
coverage/
*.dill

# Distribution bundle (flutterbase's scripts/build.sh writes it here).
dist/

# Machine-local SDK paths.
android/local.properties
android/.gradle/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Written by the Flutter tool on `flutter pub get` / `flutter build`. Not
# tracked in this app (flutterbase tracks it; deck's release restores it
# after the build either way), so ignore it instead of leaving it untracked.
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Editor and OS noise.
.idea/
*.iml
.vscode/
.DS_Store
